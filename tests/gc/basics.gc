# GruselCore basics: drum steps, a kit load, 303 steps, play, a cue, a type change, save and reboot
wait 100
expect view 0
tap SEQ
expect view 1
expect type.0 11
expect type.2 22
shot 01_seq_drum
# a kick on 1 5 9 13 (sound 1 is selected)
tapkey w0
tapkey w4
tapkey w8
tapkey w12
expect hit.0.0.0 1
expect hit.0.0.4 1
# a clap on 5 and 13: black key 3 picks the clap
tapkey b2
expect snd 2
tapkey w4
tapkey w12
expect hit.0.2.12 1
shot 02_seq_steps
tap PLAY
peakreset
wait 1500
expect playing 1
expect peak_min 5
# load the Psytrance kit while playing (PRESETS: from kit 1 Hardtek to kit 7)
turn PRESET 6
expect kit.0 6
shot 03_kit_loaded
# track 3: a 303 step, its note up
turn ALGO 2
expect trk 2
holdkey w0
turn K1 5
shot 04_303_held
releasekey w0
expect gate.2.0 1
expect note.2.0 41
tapkey w2
tapkey w3
# home: cue pattern 2
tap HOME
expect view 0
shot 05_home
hold HOME
tapkey w1
release HOME
wait 2500
expect cur 1
hold HOME
tapkey w0
release HOME
wait 2500
expect cur 0
# the mixer
tap LFO
shot 06_mixer
# track 5 becomes a drum track (GLO, knob 1, SEL)
turn ALGO 2
expect trk 4
tap GLO
turn K1 1
tap SEL
wait 50
expect type.4 11
shot 07_glo
tap FX
shot 08_fx
turn K1 -20
tap EDIT
shot 09_edit
tap PLAY
wait 100
tap SAVE
wait 100
expect dirty 0
reboot
expect type.4 11
expect hit.0.2.12 1
expect kit.0 6
expect note.2.0 41
