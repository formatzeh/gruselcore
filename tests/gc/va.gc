# The VA: a track set to VA, its presets, HOME's knobs, EDIT's pages, chords on steps, the arpeggiator,
# the keys (CHORD mode plays the keys held together), and 303 <-> VA keeping the steps
tap HOME
turn ALGO 4
expect trk 4
tap GLO
turn K1 3
tap SEL
expect type.4 33
expect kit.4 0
tap HOME
shot va_home
# a preset (PRESETS knob, also on HOME): TRANCE LEAD, a unison
turn PRESET 2
expect kit.4 2
expect va.4.20 2
# HOME: KNOB 1 is the cutoff
turn K1 -5
expect va.4.8 80
# the keys play it
peakreset
holdkey w0
wait 300
expect sounds.4 1
releasekey w0
wait 1500
# EDIT: page 1 the oscillators, SELECT to the filter page (3)
tap EDIT
turn SELECT 1
turn SELECT 1
turn K2 10
expect va.4.9 50
shot va_edit
# SEQ: a step on, then held: its chord (KNOB 3) MIN
tap SEQ
tapkey w0
expect gate.4.0 1
holdkey w0
turn K3 4
expect chord.4.0 4
expect gate.4.0 1
shot va_step_chord
releasekey w0
# ENV + a step: its accent
hold ENV
tapkey w0
release ENV
expect acc.4.0 1
expect gate.4.0 1
# ARP: the arpeggiator's page; UP, 2 notes a step
tap ARP
expect spage 1
expect view 1
turn K1 1
turn K2 1
expect arp.4 1
expect arpdiv.4 1
shot va_arp
tap ARP
expect spage 0
# playing: the VA sounds
tapkey w4
tap PLAY
peakreset
wait 1200
expect sounds.4 1
expect peak_min 5
tap PLAY
# 303 <-> VA keeps the steps
tap HOME
tap GLO
turn K1 -1
tap SEL
expect type.4 22
expect gate.4.0 1
expect chord.4.0 4
tap HOME
tap GLO
turn K1 1
tap SEL
expect type.4 33
expect gate.4.4 1

