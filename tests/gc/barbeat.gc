# bar.beat as Skiff: the selected track's place in its pattern (145 BPM: a beat 414 ms). 16 steps run
# 1.1 .. 1.4 and again; 32 steps 1.1 .. 2.4; the top line follows
tap HOME
expect barbeat 11
tap PLAY
wait 2300
expect barbeat 12
expect topbar 1
shot barbeat_playing
wait 5000
expect barbeat 12
tap PLAY
wait 100
expect barbeat 11
# 32 steps
tap SEQ
turn K1 1
expect len.0 32
tap HOME
tap PLAY
wait 2300
expect barbeat 22
wait 5000
expect barbeat 12
tap PLAY
