# Live: everything changed while playing, nothing stops, the sound keeps going
tap SEQ
tapkey w0
tapkey w4
tapkey w8
tapkey w12
tap PLAY
wait 500
expect playing 1
# lengths and rates on the fly
turn K1 2
expect len.0 64
turn K2 4
turn K1 -3
expect len.0 8
turn K2 -4
turn K1 1
expect len.0 16
# every track's type changed while playing, back and forth
turn ALGO 7
tap GLO
turn K1 1
tap SEL
turn K1 1
tap SEL
turn K1 1
tap SEL
expect type.7 0
turn ALGO -2
turn K1 2
tap SEL
expect type.5 22
# kits loaded on track 1 through all 13
turn ALGO -5
tap EDIT
turn PRESET 1
turn PRESET 1
turn PRESET 1
turn PRESET 1
turn PRESET 1
turn PRESET 1
turn PRESET 1
turn PRESET 1
turn PRESET 1
turn PRESET 1
turn PRESET 1
turn PRESET 1
turn PRESET 1
expect kit.0 0
# drives, filters and sends turned hard on every page
tap FX
turn K1 -64
turn K2 64
turn K3 127
tap FX
turn K1 40
turn K2 60
turn K3 60
turn K4 60
turn SELECT 1
turn K1 40
turn K2 60
peakreset
wait 2000
expect playing 1
expect peak_min 5
# patterns cued one after another
tap HOME
hold HOME
tapkey w3
release HOME
wait 1700
expect cur 3
hold HOME
tapkey w0
release HOME
wait 1700
expect cur 0
tap PLAY
wait 200
expect playing 0
